# Node-local runtime state -- created by genesis, never shipped, never committed.
.intentops/
.intentops-rules/

# Key material -- must never enter this repository, in any form.
*.key
*.pem
*private*.pem
*-private.json
id_ed25519
id_ed25519.pub

# Identity: this repo ships the CONTRACT, never a filled identity.
# The README.md under identity/ is the pointer document and is tracked;
# everything else under identity/ is node-local and must not be committed.
identity/*
!identity/README.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
